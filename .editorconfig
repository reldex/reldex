root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust
[*.rs]
indent_size = 4

# C / C++
[*.{c,h,cc,cpp,cxx,hpp,hxx}]
indent_size = 4

# QML
[*.qml]
indent_size = 4

# CMake
[{CMakeLists.txt,*.cmake}]
indent_size = 4

# Python
[*.py]
indent_size = 4

# TOML
[*.toml]
indent_size = 4

# YAML / JSON
[*.{yml,yaml,json}]
indent_size = 2

# Markdown (SPEC.md relies on two-space line breaks; do not strip them)
[*.md]
trim_trailing_whitespace = false

# Makefiles require tabs
[Makefile]
indent_style = tab

# Windows shell scripts
[*.{bat,cmd,ps1}]
end_of_line = crlf
