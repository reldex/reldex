# ---------------------------------------------------------------------------
# tools/oracle-test-db/.env.example
#
# Copy this file to `.env` (already gitignored) and fill in real values for
# local development. Never commit the real `.env` file.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# Oracle System Identifier for the Non-CDB instance created inside the
# container. Keep this short and uppercase (ORACLE_SID conventions).
ORACLE_SID=RELDEX

# Password assigned to SYS, SYSTEM and PDBADMIN inside the container on
# first start. Use a simple, obviously-local dev password: letters, digits,
# and underscores only, starting with a letter (Oracle password rules on
# this image are stricter than plain SQL*Plus defaults).
# This is a LOCAL DEV ONLY container bound to 127.0.0.1 - do not reuse any
# real credential here.
ORACLE_PWD=Reldex_Dev_19c

# Character set for the database. Reldex requires full Unicode/Thai support,
# so this MUST be AL32UTF8 (the image's own default, WE8MSWIN1252, is not
# sufficient and must not be used).
ORACLE_CHARACTERSET=AL32UTF8

# Password for the RELDEX_TEST application/test user created by
# init/01_create_test_user.sql. Defaults to the same dev password as above;
# override here if you want a distinct value. Documented dev default only -
# never a real credential.
RELDEX_TEST_PWD=Reldex_Test_19c
