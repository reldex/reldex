# ---------------------------------------------------------------------------
# tools/oracle-test-db/.env.example
#
# Copy this file to `.env` (already gitignored) and replace every
# CHANGE_ME_... placeholder with a value you choose. Never commit `.env`, and
# never put a real credential in either file.
#
#   cp .env.example .env
#   # edit .env, then:
#   docker compose -f tools/oracle-test-db/compose.yaml up -d
#
# Nothing in this file is a working password: the placeholders are deliberately
# invalid for the image (they contain no digit), so a copy that was not edited
# fails loudly at container start instead of creating a database with a
# published password.
#
# If the container already exists and you only want to change the test user's
# password, edit RELDEX_TEST_PWD here and re-run the setup hook without
# destroying the database:
#
#   docker exec -e RELDEX_TEST_PWD="<the new value>" reldex-oracle19c \
#       bash /opt/oracle/scripts/setup/01_create_test_user.sh
#
# ORACLE_PWD is only used on **first** start (DBCA sets SYS/SYSTEM then); to
# change it afterwards use the image's own `/opt/oracle/setPassword.sh`.
# ---------------------------------------------------------------------------

# Oracle System Identifier for the Non-CDB instance created inside the
# container. Keep this short and uppercase (ORACLE_SID conventions).
ORACLE_SID=RELDEX

# Password assigned to SYS, SYSTEM and PDBADMIN inside the container on first
# start. Choose a simple, obviously-local dev value: letters, digits and
# underscores only, starting with a letter and containing at least one digit
# (Oracle's password rules on this image are stricter than plain SQL*Plus
# defaults). This is a LOCAL DEV ONLY container bound to 127.0.0.1 — do not
# reuse any real credential here, and do not copy this value from anywhere.
ORACLE_PWD=CHANGE_ME_local_only

# Character set for the database. Reldex requires full Unicode/Thai support,
# so this MUST be AL32UTF8 (the image's own default, WE8MSWIN1252, is not
# sufficient and must not be used).
ORACLE_CHARACTERSET=AL32UTF8

# The application/test user the integration tests connect as, and its
# password. `compose.yaml` passes both into the container, where
# `init/01_create_test_user.sh` creates or updates the user with them. Same
# rules as above: letters, digits and underscores, starting with a letter, at
# least one digit, no quotes or whitespace.
RELDEX_TEST_USER=RELDEX_TEST
RELDEX_TEST_PWD=CHANGE_ME_local_only
